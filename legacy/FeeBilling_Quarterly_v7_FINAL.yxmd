    <Node ToolID="7">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
        <Position x="570" y="186" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <FormulaFields>
            <FormulaField expression="IF [total_aum] &lt; 1000000 THEN 100&#xA;ELSEIF [total_aum] &lt; 5000000 THEN 75&#xA;ELSEIF [total_aum] &lt; 10000000 THEN 50&#xA;ELSE 35&#xA;ENDIF" field="annual_rate_bps" size="8" type="Int32" />
          </FormulaFields>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name />
          <DefaultAnnotationText>rate lookup</DefaultAnnotationText>
          <Left value="False" />
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula" />
    </Node>
    <Node ToolID="8">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
        <Position x="690" y="186" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <FormulaFields>
            <FormulaField expression="Round([total_aum] * [annual_rate_bps] / 10000 / 4, 0.01)" field="gross_fee" size="8" type="Double" />
            <FormulaField expression="IIF([gross_fee] &lt; 250, 250, [gross_fee])" field="billable_fee" size="8" type="Double" />
            <FormulaField expression="&quot;2026Q3&quot;" field="billing_period" size="8" type="V_String" />
          </FormulaFields>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name />
          <DefaultAnnotationText>fee calc + minimum</DefaultAnnotationText>
          <Left value="False" />
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula" />
    </Node>
